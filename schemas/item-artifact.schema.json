{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/injammed/ITEM/schemas/item-artifact.schema.json",
  "title": "ITEM Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "status",
    "summary",
    "entropy_thesis",
    "forms",
    "canon_score",
    "routing"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^ITEM-[0-9A-Z_-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["canon", "candidate", "refinement_required", "deprecated", "deleted"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "entropy_thesis": {
      "type": "string",
      "description": "Why this artifact preserves, resists decay, or converts momentary expression into durable form."
    },
    "forms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["physical", "digital", "visual", "economic", "narrative", "interface", "protocol_adjacent"]
      }
    },
    "implementation_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "canon_score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durability", "specificity", "implementation_value", "coherence"],
      "properties": {
        "durability": { "type": "integer", "minimum": 0, "maximum": 3 },
        "specificity": { "type": "integer", "minimum": 0, "maximum": 3 },
        "implementation_value": { "type": "integer", "minimum": 0, "maximum": 3 },
        "coherence": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_repo", "secondary_repos"],
      "properties": {
        "primary_repo": { "type": "string", "enum": ["ITEM", "ABYS", "SYNTEL"] },
        "secondary_repos": {
          "type": "array",
          "items": { "type": "string", "enum": ["ITEM", "ABYS", "SYNTEL"] }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
