{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/injammed/ITEM/schemas/artifact.schema.json",
  "title": "ITEM Canonical Artifact",
  "description": "Machine-readable record for a bounded ITEM artifact that has survived canon review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_id",
    "name",
    "artifact_class",
    "status",
    "summary",
    "object_boundary",
    "ontology_link",
    "materialization_paths",
    "canonical_value",
    "provenance",
    "review"
  ],
  "properties": {
    "item_id": {
      "type": "string",
      "pattern": "^ITEM-[0-9]{4}$",
      "description": "Stable canonical identifier, e.g. ITEM-0001."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "artifact_class": {
      "type": "string",
      "enum": [
        "doctrine",
        "visual",
        "physical",
        "narrative",
        "economic",
        "interface",
        "hybrid"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "canonical",
        "deprecated",
        "quarantined",
        "rejected"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "object_boundary": {
      "type": "string",
      "minLength": 20,
      "description": "Defines what the artifact is and what it is not."
    },
    "ontology_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_axis", "time_relation"],
      "properties": {
        "primary_axis": {
          "type": "string",
          "enum": ["ITEM_vs_TIME", "anti_entropy", "artifact_memory", "economic_symbol", "museum_interface", "other"]
        },
        "time_relation": {
          "type": "string",
          "description": "How this artifact resists, records, compresses, or dramatizes time."
        },
        "related_items": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "materialization_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["render", "manufacture", "simulate", "sell", "display", "publish", "protocol_reference", "museum_scene"]
      }
    },
    "implementation_path": {
      "type": "string",
      "description": "Practical path to make, render, display, simulate, sell, or route the artifact."
    },
    "canonical_value": {
      "type": "string",
      "minLength": 20,
      "description": "Why this belongs in canon rather than notes, quarantine, or deprecated material."
    },
    "slop_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "duplicate_name",
          "undefined_boundary",
          "rhetorical_grandiosity",
          "no_materialization_path",
          "ontology_sprawl",
          "economic_claim_without_use",
          "visual_without_spec",
          "implementation_free_cosmology"
        ]
      },
      "default": []
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "created_by", "created_at", "source_fragments"],
      "properties": {
        "origin": { "type": "string" },
        "created_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date" },
        "source_fragments": { "type": "array", "items": { "type": "string" } },
        "derived_from": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "score", "reviewed_by", "review_date"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["accept", "revise", "quarantine", "deprecate", "reject"]
        },
        "score": {
          "type": "object",
          "additionalProperties": false,
          "required": ["boundary", "materialization", "distinctiveness", "implementation", "provenance"],
          "properties": {
            "boundary": { "type": "integer", "minimum": 0, "maximum": 5 },
            "materialization": { "type": "integer", "minimum": 0, "maximum": 5 },
            "distinctiveness": { "type": "integer", "minimum": 0, "maximum": 5 },
            "implementation": { "type": "integer", "minimum": 0, "maximum": 5 },
            "provenance": { "type": "integer", "minimum": 0, "maximum": 5 }
          }
        },
        "reviewed_by": { "type": "array", "items": { "type": "string" } },
        "review_date": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      }
    }
  }
}
