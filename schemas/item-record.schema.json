{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/injammed/ITEM/schemas/item-record.schema.json",
  "title": "ITEM Canonical Artifact Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_id",
    "canonical_name",
    "status",
    "canonical_status_reason",
    "route",
    "slop_risk",
    "object_type",
    "function",
    "artifact_layers",
    "symbolic_claims",
    "implementation_surface",
    "validation_requirements",
    "provenance",
    "judgment_result",
    "review_notes"
  ],
  "properties": {
    "item_id": { "type": "string", "pattern": "^ITEM-[0-9A-Z_-]+$" },
    "canonical_name": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["candidate", "canon", "deprecated", "archive", "slatra_containment"] },
    "canonical_status_reason": { "type": "string", "minLength": 20 },
    "route": { "type": "string", "enum": ["ITEM", "ABYS", "SYNTEL", "SLATRA_CONTAINMENT", "ARCHIVE"] },
    "slop_risk": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "object_type": {
      "type": "string",
      "enum": [
        "physical_object",
        "digital_object",
        "image_spec",
        "narrative_asset",
        "economic_unit",
        "schema",
        "hybrid_artifact",
        "machine_native_symbolic_system"
      ]
    },
    "function": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "artifact_layers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["description"],
        "properties": {
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "symbolic_claims": { "type": "array", "items": { "type": "string" } },
    "implementation_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderable", "fabricable", "simulatable", "sellable"],
      "properties": {
        "renderable": { "type": "boolean" },
        "fabricable": { "type": "boolean" },
        "simulatable": { "type": "boolean" },
        "sellable": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "validation_requirements": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "created_by", "created_at"],
      "properties": {
        "source": { "type": "string" },
        "created_by": { "type": "string" },
        "created_at": { "type": "string" },
        "related_records": { "type": "array", "items": { "type": "string" } },
        "source_files": { "type": "array", "items": { "type": "string" } }
      }
    },
    "judgment_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positiveScore", "slopRisk", "finalScore", "route", "vetoes", "reason", "next_action"],
      "properties": {
        "positiveScore": { "type": "integer", "minimum": 0, "maximum": 70 },
        "slopRisk": { "type": "integer", "minimum": 0, "maximum": 10 },
        "finalScore": { "type": "integer", "minimum": -10, "maximum": 70 },
        "route": { "type": "string", "enum": ["CANON_READY", "AETIMM_CANDIDATE", "REFINEMENT_REQUIRED", "ARCHIVE_ONLY", "SLATRA_CONTAINMENT"] },
        "vetoes": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string", "minLength": 1 },
        "next_action": { "type": "string", "minLength": 1 }
      }
    },
    "lineage": { "type": "array", "items": { "type": "string" } },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public_display_allowed": { "type": "boolean" },
        "ai_transformation_allowed": { "type": "boolean" },
        "canon_review_allowed": { "type": "boolean" },
        "training_or_evaluation_allowed": { "type": "boolean" }
      }
    },
    "review_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "reason", "next_action"],
      "properties": {
        "classification": { "type": "string", "enum": ["preserve", "refine", "redirect", "deprecate", "delete"] },
        "reason": { "type": "string", "minLength": 1 },
        "next_action": { "type": "string", "minLength": 1 }
      }
    }
  }
}
